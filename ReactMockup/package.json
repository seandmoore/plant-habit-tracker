{
  "name": "plant-companion-react-mockup",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web:export": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "sync:catalog": "node scripts/sync-catalog.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.11",
    "@expo/vector-icons": "^15.0.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "expo": "~57.0.14",
    "expo-blur": "~57.0.0",
    "expo-constants": "~57.0.10",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.11",
    "expo-linear-gradient": "~57.0.0",
    "expo-linking": "~57.0.6",
    "expo-router": "~57.0.14",
    "expo-status-bar": "~57.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "0.87.0",
    "react-native-safe-area-context": "~5.9.1",
    "react-native-screens": "~4.27.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.1",
    "@types/react": "~19.2.0",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.4",
    "react-test-renderer": "19.2.8",
    "typescript": "~6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts",
      "<rootDir>/src/**/*.test.tsx"
    ],
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)$": "<rootDir>/src/$1"
    }
  }
}
