{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "plant-companion-proxy",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-07-18",
  "observability": {
    "enabled": true
  },
  "ratelimits": [
    {
      "name": "PLANT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 12,
        "period": 60
      }
    }
  ]
}
